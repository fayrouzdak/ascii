---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const asciiCharColors: { hex: string; label: string }[] = [
  { hex: '#a8a9b0', label: 'Grey' },
  { hex: '#8b91d4', label: 'Blue lavender' },
  { hex: '#bc8bd4', label: 'Lilac' },
  { hex: '#95bd9b', label: 'Sage' },
  { hex: '#cecda3', label: 'Olive' },
  { hex: '#d48b8f', label: 'Rose' },
];
const asciiCharColorDefault = asciiCharColors[0].hex;
const asciiColorSwatchBtnClass =
  'box-border flex h-5 w-5 shrink-0 cursor-default items-center justify-center border-2 border-white/25 bg-transparent p-0 transition-colors hover:border-white/90 aria-pressed:border-white/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-white/40';
---

<div
  id="controls"
  class:list={[
    'pointer-events-auto fixed z-[36] hidden flex min-h-0 max-w-[min(430px,calc(100vw-24px))] flex-col border border-white/5 bg-[#171617] text-white shadow-[0_8px_40px_rgba(0,0,0,0.45)]',
    'max-h-[min(560px,calc(100dvh-24px))]',
    className,
  ]}
>
  <div
    id="controls-scroll"
    class="hidden flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto overflow-x-visible p-[12px] text-[15px]"
  >
    <!-- Blur / sharpen -->
    <section class="flex flex-col gap-y-2">
      <h2 class="text-[12px] font-normal uppercase text-white/30">Image detail</h2>
      <div class="flex flex-col gap-y-2">
        <div class="flex min-w-0 items-center gap-1.5">
          <input type="hidden" id="ascii-color" value={asciiCharColorDefault} aria-labelledby="ascii-color-label" />
          <span id="ascii-color-label" class="min-w-0 flex-1 text-white/70 uppercase">Character color</span>
          <div
            class="flex shrink-0 flex-nowrap items-center justify-end gap-2.5"
            role="group"
            aria-labelledby="ascii-color-label"
          >
            {asciiCharColors.map((c, i) => (
              <button
                type="button"
                data-ascii-color={c.hex}
                title={c.label}
                aria-label={c.label}
                aria-pressed={i === 0}
                class={asciiColorSwatchBtnClass}
              >
                <span
                  class="h-4 w-4 shrink-0"
                  style={`background-color: ${c.hex}`}
                  aria-hidden="true"
                />
              </button>
            ))}
          </div>
        </div>
        <div class="flex min-w-0 items-center gap-1.5">
          <label for="zoom-slider" class="min-w-0 flex-1 text-white/70 uppercase">View zoom</label>
          <div class="relative flex min-h-[20px] min-w-0 flex-1 items-center">
            <input
              type="range"
              id="zoom-slider"
              min="-100"
              max="100"
              value="0"
              class="range-bar relative z-[1] min-w-0 w-full"
            />
            <span
              id="zoom-value"
              class="pointer-events-none absolute left-1.5 top-1/2 z-[2] -translate-y-1/2 text-[14px] leading-none tracking-wide text-white tabular-nums"
              aria-hidden="true"
            >0</span>
          </div>
        </div>
        <div class="flex w-full min-w-0 flex-row items-center gap-1.5">
          <label for="output-cols" class="min-w-0 flex-1 text-white/70 uppercase" title="How many characters wide the ASCII output is">Output columns</label>
          <div class="relative flex min-h-[20px] min-w-0 flex-1 items-center">
            <input
              type="range"
              id="output-cols"
              min="1"
              max="100"
              value="100"
              class="range-bar relative z-[1] min-w-0 w-full"
            />
            <span
              id="output-cols-val"
              class="pointer-events-none absolute left-1.5 top-1/2 z-[2] -translate-y-1/2 text-[14px] leading-none tracking-wide text-white tabular-nums"
              aria-hidden="true"
            >100</span>
          </div>
        </div>
        <div class="flex min-w-0 items-center gap-1.5">
          <label for="blur" class="min-w-0 flex-1 text-white/70 uppercase">Source blur</label>
          <div class="relative flex min-h-[20px] min-w-0 flex-1 items-center">
            <input
              type="range"
              id="blur"
              min="0"
              max="10"
              value="0"
              step="0.5"
              class="range-bar relative z-[1] min-w-0 w-full"
            />
            <span
              id="blur-val"
              class="pointer-events-none absolute left-1.5 top-1/2 z-[2] -translate-y-1/2 text-[14px] leading-none tracking-wide text-white tabular-nums"
              aria-hidden="true"
            >0</span>
          </div>
        </div>
        <div class="flex min-w-0 items-center gap-1.5">
          <label for="sharpness" class="min-w-0 flex-1 text-white/70 uppercase">Sharpening</label>
          <div class="relative flex min-h-[20px] min-w-0 flex-1 items-center">
            <input
              type="range"
              id="sharpness"
              min="0"
              max="20"
              value="9"
              class="range-bar relative z-[1] min-w-0 w-full"
            />
            <span
              id="sharpness-val"
              class="pointer-events-none absolute left-1.5 top-1/2 z-[2] -translate-y-1/2 text-[14px] leading-none tracking-wide text-white tabular-nums"
              aria-hidden="true"
            >9</span>
          </div>
        </div>
        <label class="flex min-w-0 cursor-default select-none items-center gap-1.5" for="ignore-white-toggle">
          <span class="min-w-0 flex-1 text-white/70 uppercase">Ignore white pixels</span>
          <span class="flex min-w-0 flex-1 items-center justify-end">
            <span
              dir="ltr"
              class="relative inline-block shrink-0 has-[input:focus-visible]:ring-1 has-[input:focus-visible]:ring-white/40 has-[input:focus-visible]:ring-offset-2 has-[input:focus-visible]:ring-offset-[#141314]"
            >
              <input
                type="checkbox"
                id="ignore-white-toggle"
                class="pixel-toggle-input absolute inset-0 z-[1] m-0 size-full cursor-default opacity-0"
              />
              <span class="pixel-toggle-track pointer-events-none" aria-hidden="true"></span>
            </span>
          </span>
        </label>
      </div>
    </section>

    <!-- Character style (custom list opens below; native select is hidden for state) -->
    <section class="flex flex-col gap-y-2">
      <h2 class="text-[12px] font-normal uppercase text-white/30">Character style</h2>
      <div class="flex min-w-0 items-center gap-1.5">
        <label for="style-select-trigger" class="min-w-0 flex-1 text-white/70">Style preset</label>
        <div id="style-select-dropdown" class="relative min-w-0 flex-1">
          <select id="style-select" class="hidden" tabindex="-1" aria-hidden="true">
            <option value="shaded:fine-detail" selected>Fine detail</option>
            <option value="shaded:block-shades">Block shades</option>
            <option value="shaded:binary">Binary</option>
            <option value="shaded:dos-glyphs">DOS &amp; box</option>
            <option value="shaded:math">Math &amp; science</option>
            <option value="random">Random</option>
            <option value="cross">Crosses</option>
            <option value="dots">Dots</option>
          </select>
          <button
            type="button"
            id="style-select-trigger"
            class="flex h-7 w-full min-w-0 items-center justify-between gap-2 border-0 bg-white/5 px-2 py-0 text-left text-[15px] font-normal uppercase text-white ring-0 outline-none focus:ring-0 focus:outline-none focus-visible:ring-0 focus-visible:outline-none"
            aria-label="Character style preset"
            aria-expanded="false"
            aria-haspopup="listbox"
            aria-controls="style-select-menu"
          >
            <span id="style-select-current" class="min-w-0 truncate leading-none uppercase">Fine detail</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="size-4 shrink-0 text-white/40" aria-hidden="true">
              <path d="M13 16h-2v-2h2v2Zm-2-2H9v-2h2v2Zm4 0h-2v-2h2v2Zm-6-2H7v-2h2v2Zm8 0h-2v-2h2v2ZM7 10H5V8h2v2Zm12 0h-2V8h2v2Z" />
            </svg>
          </button>
          <div
            id="style-select-menu"
            role="listbox"
            class="fixed z-[100] hidden border border-white/5 bg-[#171617] font-normal uppercase [font-variant:normal]"
            aria-label="Character style preset"
          >
            <button type="button" role="option" data-value="shaded:fine-detail" class="w-full px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/80 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white">Fine detail</button>
            <button type="button" role="option" data-value="shaded:block-shades" class="w-full px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/80 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white">Block shades</button>
            <button type="button" role="option" data-value="shaded:binary" class="w-full px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/80 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white">Binary</button>
            <button type="button" role="option" data-value="shaded:dos-glyphs" class="w-full px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/80 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white">DOS &amp; box</button>
            <button type="button" role="option" data-value="shaded:math" class="w-full px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/80 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white">Math &amp; science</button>
            <button type="button" role="option" data-value="random" class="w-full px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/80 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white">Random</button>
            <button type="button" role="option" data-value="cross" class="w-full px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/80 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white">Crosses</button>
            <button type="button" role="option" data-value="dots" class="w-full px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/80 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white">Dots</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Color grading -->
    <section class="flex flex-col gap-y-2">
      <h2 class="text-[12px] font-normal uppercase text-white/30">Color &amp; tone</h2>
      <div class="flex flex-col gap-y-2">
        <div class="flex min-w-0 items-center gap-1.5">
          <label for="brightness" class="min-w-0 flex-1 text-white/70 uppercase">Brightness</label>
          <div class="relative flex min-h-[20px] min-w-0 flex-1 items-center">
            <input
              type="range"
              id="brightness"
              min="-100"
              max="100"
              value="0"
              class="range-bar relative z-[1] min-w-0 w-full"
            />
            <span
              id="brightness-val"
              class="pointer-events-none absolute left-1.5 top-1/2 z-[2] -translate-y-1/2 text-[14px] leading-none tracking-wide text-white tabular-nums"
              aria-hidden="true"
            >0</span>
          </div>
        </div>
        <div class="flex min-w-0 items-center gap-1.5">
          <label for="contrast" class="min-w-0 flex-1 text-white/70 uppercase">Contrast</label>
          <div class="relative flex min-h-[20px] min-w-0 flex-1 items-center">
            <input
              type="range"
              id="contrast"
              min="-100"
              max="100"
              value="0"
              class="range-bar relative z-[1] min-w-0 w-full"
            />
            <span
              id="contrast-val"
              class="pointer-events-none absolute left-1.5 top-1/2 z-[2] -translate-y-1/2 text-[14px] leading-none tracking-wide text-white tabular-nums"
              aria-hidden="true"
            >0</span>
          </div>
        </div>
        <div class="flex min-w-0 items-center gap-1.5">
          <label for="saturation" class="min-w-0 flex-1 text-white/70 uppercase">Saturation</label>
          <div class="relative flex min-h-[20px] min-w-0 flex-1 items-center">
            <input
              type="range"
              id="saturation"
              min="0"
              max="100"
              value="100"
              class="range-bar relative z-[1] min-w-0 w-full"
            />
            <span
              id="saturation-val"
              class="pointer-events-none absolute left-1.5 top-1/2 z-[2] -translate-y-1/2 text-[14px] leading-none tracking-wide text-white tabular-nums"
              aria-hidden="true"
            >100</span>
          </div>
        </div>
        <div class="flex min-w-0 items-center gap-1.5">
          <label for="hue" class="min-w-0 flex-1 text-white/70 uppercase">Hue shift</label>
          <div class="relative flex min-h-[20px] min-w-0 flex-1 items-center">
            <input
              type="range"
              id="hue"
              min="0"
              max="360"
              value="0"
              class="range-bar relative z-[1] min-w-0 w-full"
            />
            <span
              id="hue-val"
              class="pointer-events-none absolute left-1.5 top-1/2 z-[2] -translate-y-1/2 text-[14px] leading-none tracking-wide text-white tabular-nums"
              aria-hidden="true"
            >0</span>
          </div>
        </div>
        <label class="flex min-w-0 cursor-default select-none items-center gap-1.5" for="invert-toggle">
          <span class="min-w-0 flex-1 text-white/70 uppercase">Invert colors</span>
          <span class="flex min-w-0 flex-1 items-center justify-end">
            <span
              dir="ltr"
              class="relative inline-block shrink-0 has-[input:focus-visible]:ring-1 has-[input:focus-visible]:ring-white/40 has-[input:focus-visible]:ring-offset-2 has-[input:focus-visible]:ring-offset-[#141314]"
            >
              <input
                type="checkbox"
                id="invert-toggle"
                class="pixel-toggle-input absolute inset-0 z-[1] m-0 size-full cursor-default opacity-0"
              />
              <span class="pixel-toggle-track pointer-events-none" aria-hidden="true"></span>
            </span>
          </span>
        </label>
      </div>
    </section>
  </div>
</div>
