---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'ASCII' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="ASCII transforms images into dynamic grids of text characters, blending retro aesthetics with modern digital art." />
    <title>{title}</title>
  </head>
  <body
    class="box-border min-h-[100dvh] w-full overflow-x-hidden bg-[#141314] text-[15px] uppercase text-white max-md:flex max-md:items-center max-md:justify-center max-md:overflow-y-auto max-md:pb-[max(40px,env(safe-area-inset-bottom,0px))] max-md:pt-[max(40px,env(safe-area-inset-top,0px))] md:m-0 md:overflow-y-hidden md:p-0"
  >
    <slot />
  </body>
</html>
