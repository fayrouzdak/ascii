---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'ASCII' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="ASCII transforms images into dynamic grids of text characters, blending retro aesthetics with modern digital art." />
    <title>{title}</title>
  </head>
  <body class="bg-[#141314] text-[15px] uppercase text-white flex h-screen min-h-0 items-center justify-center overflow-hidden">
    <slot />
  </body>
</html>
