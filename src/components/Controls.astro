---

<div
  id="controls"
  class="hidden w-full px-4 py-3 border-t border-white/10 bg-black flex flex-wrap items-center gap-x-6 gap-y-3 text-xs"
>
  <!-- Effect selector -->
  <div class="flex items-center gap-2">
    <label for="effect-select" class="text-white/50 tracking-widest uppercase text-[10px]">Effect</label>
    <select
      id="effect-select"
      class="bg-black border border-white/20 text-white text-xs px-2 py-1 cursor-pointer hover:border-white/50 transition-colors focus:outline-none focus:border-white/70"
    >
      <option value="none">None (static)</option>
      <option value="assembly" selected>Assembly</option>
      <option value="wave">Wave</option>
      <option value="mouse-react">Mouse React</option>
      <option value="cycle">Cycle</option>
    </select>
  </div>

  <!-- Replay button (for assembly/cycle) -->
  <button
    id="replay-btn"
    class="border border-white/20 text-white/60 text-[10px] tracking-widest uppercase px-3 py-1 hover:border-white/60 hover:text-white transition-colors"
  >
    Replay
  </button>

  <!-- Density -->
  <div class="flex items-center gap-2">
    <label for="density-slider" class="text-white/50 tracking-widest uppercase text-[10px]">Density</label>
    <input
      type="range"
      id="density-slider"
      min="3"
      max="16"
      value="16"
      class="w-20 sm:w-28 accent-white cursor-pointer"
    />
    <span id="density-value" class="text-white/40 w-4 text-right">16</span>
  </div>

  <!-- Speed -->
  <div class="flex items-center gap-2">
    <label for="speed-slider" class="text-white/50 tracking-widest uppercase text-[10px]">Speed</label>
    <input
      type="range"
      id="speed-slider"
      min="0"
      max="100"
      value="50"
      class="w-20 sm:w-28 accent-white cursor-pointer"
    />
  </div>

  <!-- New image -->
  <button
    id="new-image-btn"
    class="ml-auto border border-white/20 text-white/60 text-[10px] tracking-widest uppercase px-3 py-1 hover:border-white/60 hover:text-white transition-colors"
  >
    New Image
  </button>
</div>
