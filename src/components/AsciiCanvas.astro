---
import Controls from './Controls.astro';
---

<div
  class="relative mx-auto flex h-full min-h-0 w-full min-w-0 flex-1 flex-col overflow-hidden transition-colors max-md:max-h-none max-md:min-h-0 max-md:w-full md:max-h-[550px] md:max-w-[min(550px,calc(100%-40px))] md:flex-row"
  id="canvas-container"
>
  <div
    id="ascii-stack"
    class="relative flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden max-md:min-h-0 max-md:[container-type:size]"
  >
    <pre
      id="ascii-pre"
      class="relative m-0 min-h-0 min-w-0 flex-1 cursor-text select-text overflow-hidden p-0 outline-none max-md:p-4"
      aria-label="ASCII output"
    ><code
        id="ascii-code"
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 whitespace-pre text-left normal-case tracking-normal"
      ></code></pre>
    <!-- Upload zone is layered on the canvas only, hidden after image load -->
    <slot />
  </div>
  <div
    id="controls-dock"
    class="contents max-md:flex max-md:shrink-0 max-md:relative max-md:z-[35] max-md:w-full max-md:flex-col max-md:items-stretch max-md:overflow-hidden max-md:divide-y max-md:divide-white/5 max-md:border-t max-md:border-white/5 max-md:bg-[#171617]"
  >
    <Controls />
    <div
      id="controls-footer"
      class="pointer-events-auto z-[35] hidden w-fit max-w-none shrink-0 flex flex-wrap items-center gap-x-4 gap-y-2 border border-white/5 bg-[#171617] p-[12px] text-white max-md:relative max-md:w-full max-md:max-w-none max-md:flex-nowrap max-md:justify-between max-md:gap-x-0 max-md:gap-y-0 max-md:rounded-none max-md:border-0 max-md:px-4 max-md:pt-3 max-md:pb-[max(12px,env(safe-area-inset-bottom,0px))] md:fixed md:bottom-[max(12px,env(safe-area-inset-bottom))] md:left-[max(12px,env(safe-area-inset-left))] md:right-auto md:top-auto md:max-w-[min(430px,calc(100vw-24px))]"
    >
    <button
      type="button"
      id="controls-menu-btn"
      aria-label="Adjust image"
      aria-expanded="false"
      aria-controls="controls"
      class="inline-flex h-8 w-8 shrink-0 items-center justify-center bg-white/5 text-white/60 transition-colors hover:bg-[#2A63FF]/10 hover:text-[#2A63FF]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="size-4" aria-hidden="true">
        <path
          d="M10 22H6v-2h4v2Zm-4-2H4v-2H2v-2h2v-2h2v6Zm6-4h10v2H12v2h-2v-6h2v2Zm-2-2H6v-2h4v2Zm8-2h-4v-2h4v2Zm-6-4H2V6h10V4h2v6h-2V8Zm8-2h2v2h-2v2h-2V4h2v2Zm-2-2h-4V2h4v2Z"
        />
      </svg>
    </button>

    <div class="flex shrink-0 items-center gap-2.5">
      <button
        id="copy-btn"
        type="button"
        aria-label="Copy"
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center bg-white/5 text-white/60 transition-colors hover:bg-[#2A63FF]/10 hover:text-[#2A63FF]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="size-4" aria-hidden="true">
          <path
            d="M20 22H8v-2h12v2ZM8 20H6v-2H4v-2h2V8h2v12Zm14 0h-2V8h2v12ZM4 16H2V4h2v12ZM18 6h2v2H8V6h8V4h2v2Zm-2-2H4V2h12v2Z"
          />
        </svg>
      </button>
      <div id="save-dropdown" class="relative shrink-0">
        <button
          type="button"
          id="save-menu-btn"
          aria-label="Save"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="save-menu"
          class="inline-flex h-8 w-8 shrink-0 items-center justify-center bg-white/5 text-white/60 transition-colors hover:bg-[#FFC300]/10 hover:text-[#FFC300]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="size-4 shrink-0" aria-hidden="true">
            <path d="M8 3h8v2H8zm0 4h8v2H8z" />
            <path
              d="M8 7h2v6H8zm-5 4h5v2H3zm0 2h2v2H3zm2 2h2v2H5zm2 2h2v2H7zm2 2h2v2H9zm2 2h2v2h-2zm2-2h2v2h-2zm2-2h2v2h-2zm2-2h2v2h-2zm2-4h2v4h-2zm-3 0h3v2h-3zm-2-4h2v6h-2z"
            />
          </svg>
        </button>
        <div
          id="save-menu"
          role="menu"
          aria-labelledby="save-menu-btn"
          class="fixed z-[50] hidden min-w-0 flex-col border border-white/5 bg-[#171617] text-white shadow-[0_8px_40px_rgba(0,0,0,0.45)]"
        >
          <button
            id="save-txt-btn"
            type="button"
            role="menuitem"
            class="w-full break-words px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/70 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white"
          >
            Save as TXT
          </button>
          <button
            id="save-png-btn"
            type="button"
            role="menuitem"
            class="w-full break-words px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/70 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white"
          >
            Save as PNG
          </button>
          <button
            id="save-svg-btn"
            type="button"
            role="menuitem"
            class="w-full break-words px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/70 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white"
          >
            Save as SVG
          </button>
          <button
            id="save-html-btn"
            type="button"
            role="menuitem"
            class="w-full break-words px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/70 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white"
          >
            Save as HTML
          </button>
          <button
            id="save-gif-menu-btn"
            type="button"
            role="menuitem"
            class="hidden w-full break-words px-[12px] py-1.5 text-left text-[15px] font-normal uppercase text-white/70 transition-colors hover:bg-[rgba(255,255,255,0.02)] hover:text-white"
          >
            Save as GIF
          </button>
        </div>
      </div>
      <button
        id="new-image-btn"
        type="button"
        aria-label="New Image"
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center bg-white/5 text-white/60 transition-colors hover:bg-[#FF0004]/10 hover:text-[#FF0004]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="size-4" aria-hidden="true">
          <path
            d="M20 19H8v-2h12v2ZM8 17H6v-2h2v2Zm14 0h-2V7h2v10ZM6 15H4v-2h2v2Zm8 0h-2v-2h2v2Zm4 0h-2v-2h2v2ZM4 13H2v-2h2v2Zm12 0h-2v-2h2v2ZM6 11H4V9h2v2Zm8 0h-2V9h2v2Zm4 0h-2V9h2v2ZM8 9H6V7h2v2Zm12-2H8V5h12v2Z"
          />
        </svg>
      </button>
    </div>
    </div>
  </div>
</div>

<script>
  import { analyzeImage, layoutAnalysis, type ImageSource, type AsciiAnalysis } from '../lib/ascii-converter';
  import { clearMetricsCache, ensureFontLoaded } from '../lib/font-metrics';
  import { AsciiTextRenderer } from '../lib/renderer';
  import {
    defaultConversionOptions,
    type CharMode,
    type ConversionOptions,
    type TonePalette,
  } from '../lib/conversion-options';
  import {
    createAsciiExportCanvas,
    downloadAsciiHtml,
    type AsciiHtmlFrame,
    downloadAsciiPng,
    downloadAsciiText,
    downloadAsciiSvg,
    downloadGifBytes,
    encodeAsciiCanvasesToGif,
  } from '../lib/ascii-export';
  import { getPageBackgroundColor } from '../lib/page-background';
  import { isAnimatedWebP } from '../lib/animated-webp';
  import { FramePlayer } from '../lib/frame-player';

  const MAX_GIF_FRAMES = 200;
  const VIDEO_EXPORT_FPS = 12;

  function escapeHtmlForExport(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  const container = document.getElementById('canvas-container') as HTMLDivElement;
  const asciiStack = document.getElementById('ascii-stack') as HTMLDivElement | null;
  const asciiPre = document.getElementById('ascii-pre') as HTMLPreElement;
  const asciiCode = document.getElementById('ascii-code') as HTMLElement;
  const uploadZone = document.getElementById('upload-zone') as HTMLDivElement;
  const uploadZonePanel = document.getElementById('upload-zone-panel') as HTMLDivElement | null;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const newImageBtn = document.getElementById('new-image-btn') as HTMLButtonElement;
  const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
  const copyBtnDefaultHtml = copyBtn.innerHTML;
  const copySuccessSvg =
    '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="size-4" aria-hidden="true"><path d="M20 22H8V20H20V22ZM8 20H6V18H4V16H6V8H8V20ZM22 20H20V8H22V20ZM14 17H12V15H14V17ZM4 16H2V4H4V16ZM12 15H10V13H12V15ZM16 15H14V13H16V15ZM18 13H16V11H18V13ZM18 6H20V8H8V6H16V4H18V6ZM16 4H4V2H16V4Z" fill="white"/></svg>';
  const saveDropdown = document.getElementById('save-dropdown') as HTMLDivElement | null;
  const saveMenuBtn = document.getElementById('save-menu-btn') as HTMLButtonElement | null;
  const saveMenu = document.getElementById('save-menu') as HTMLDivElement | null;
  const saveTxtBtn = document.getElementById('save-txt-btn') as HTMLButtonElement;
  const savePngBtn = document.getElementById('save-png-btn') as HTMLButtonElement;
  const saveGifMenuBtn = document.getElementById('save-gif-menu-btn') as HTMLButtonElement;
  const saveSvgBtn = document.getElementById('save-svg-btn') as HTMLButtonElement;
  const saveHtmlBtn = document.getElementById('save-html-btn') as HTMLButtonElement;
  const ignoreWhiteToggle = document.getElementById('ignore-white-toggle') as HTMLInputElement;

  const asciiColor = document.getElementById('ascii-color') as HTMLInputElement;
  const asciiColorPresetButtons = document.querySelectorAll<HTMLButtonElement>('[data-ascii-color]');

  function syncAsciiColorSwatches() {
    const val = asciiColor.value.trim().toLowerCase();
    let matched = false;
    asciiColorPresetButtons.forEach((btn) => {
      const hex = (btn.dataset.asciiColor ?? '').toLowerCase();
      const on = hex === val;
      btn.setAttribute('aria-pressed', String(on));
      if (on) matched = true;
    });
    if (!matched && asciiColorPresetButtons.length > 0) {
      const first = asciiColorPresetButtons[0];
      const fallback = first.dataset.asciiColor ?? '#a8a9b0';
      asciiColor.value = fallback;
      asciiColorPresetButtons.forEach((b, i) => {
        b.setAttribute('aria-pressed', String(i === 0));
      });
    }
  }
  const zoomSlider = document.getElementById('zoom-slider') as HTMLInputElement;
  const zoomValue = document.getElementById('zoom-value') as HTMLSpanElement;
  const outputCols = document.getElementById('output-cols') as HTMLInputElement;
  const outputColsVal = document.getElementById('output-cols-val') as HTMLSpanElement;
  const brightness = document.getElementById('brightness') as HTMLInputElement;
  const brightnessVal = document.getElementById('brightness-val') as HTMLSpanElement;
  const contrast = document.getElementById('contrast') as HTMLInputElement;
  const contrastVal = document.getElementById('contrast-val') as HTMLSpanElement;
  const saturation = document.getElementById('saturation') as HTMLInputElement;
  const saturationVal = document.getElementById('saturation-val') as HTMLSpanElement;
  const hue = document.getElementById('hue') as HTMLInputElement;
  const hueVal = document.getElementById('hue-val') as HTMLSpanElement;
  const invertToggle = document.getElementById('invert-toggle') as HTMLInputElement;
  const blur = document.getElementById('blur') as HTMLInputElement;
  const blurVal = document.getElementById('blur-val') as HTMLSpanElement;
  const sharpness = document.getElementById('sharpness') as HTMLInputElement;
  const sharpnessVal = document.getElementById('sharpness-val') as HTMLSpanElement;
  const styleSelect = document.getElementById('style-select') as HTMLSelectElement;
  const styleSelectTrigger = document.getElementById('style-select-trigger') as HTMLButtonElement | null;
  const styleSelectMenu = document.getElementById('style-select-menu') as HTMLDivElement | null;
  const styleSelectDropdown = document.getElementById('style-select-dropdown') as HTMLDivElement | null;
  const styleSelectCurrent = document.getElementById('style-select-current') as HTMLSpanElement | null;
  const controlsScroll = document.getElementById('controls-scroll') as HTMLElement | null;
  const controlsDock = document.getElementById('controls-dock') as HTMLDivElement | null;
  const controlsFooter = document.getElementById('controls-footer') as HTMLDivElement | null;
  const controlsRoot = document.getElementById('controls') as HTMLElement | null;
  const controlsMenuBtn = document.getElementById('controls-menu-btn') as HTMLButtonElement | null;
  let controlsScrollHideBarTimer: ReturnType<typeof setTimeout> | null = null;
  let controlsMenuOpen = false;
  const CONTROLS_SCROLLBAR_VISIBLE_MS = 900;

  function flashControlsScrollbar() {
    if (!controlsScroll) return;
    controlsScroll.classList.add('scrollbar-active');
    if (controlsScrollHideBarTimer !== null) clearTimeout(controlsScrollHideBarTimer);
    controlsScrollHideBarTimer = window.setTimeout(() => {
      controlsScrollHideBarTimer = null;
      controlsScroll.classList.remove('scrollbar-active');
    }, CONTROLS_SCROLLBAR_VISIBLE_MS);
  }

  const SHADED_PREFIX = 'shaded:' as const;

  function parseStyleSelect(value: string): { charMode: CharMode; tonePalette: TonePalette } {
    if (value.startsWith(SHADED_PREFIX)) {
      return {
        charMode: 'shaded',
        tonePalette: 'fine-detail',
      };
    }
    return {
      charMode: value as CharMode,
      tonePalette: 'fine-detail',
    };
  }

  function styleSelectValueFromOptions(d: ConversionOptions): string {
    if (d.charMode === 'shaded') {
      return `${SHADED_PREFIX}${d.tonePalette}`;
    }
    return d.charMode;
  }

  const renderer = new AsciiTextRenderer(asciiCode);
  let currentSource: ImageSource | null = null;
  let conv: ConversionOptions = defaultConversionOptions();

  function clearControlsPanelPosition(): void {
    if (!controlsRoot) return;
    controlsRoot.style.left = '';
    controlsRoot.style.right = '';
    controlsRoot.style.top = '';
    controlsRoot.style.bottom = '';
    controlsRoot.style.width = '';
    controlsRoot.style.maxHeight = '';
  }

  /** Shared anchor: top-left of #controls-footer (viewport coordinates). */
  function getControlsFooterAnchor(): DOMRect | null {
    if (!controlsFooter) return null;
    return controlsFooter.getBoundingClientRect();
  }

  function positionControlsPanel(): void {
    if (!controlsRoot || !controlsFooter) return;
    if (controlsRoot.classList.contains('hidden')) return;
    if (window.matchMedia('(max-width: 767px)').matches) {
      clearControlsPanelPosition();
      return;
    }

    const margin = 12;
    const gap = 8;
    const maxPanelW = Math.min(430, window.innerWidth - 24);
    const maxPanelHCap = 560;
    const anchor = getControlsFooterAnchor();
    if (!anchor) return;

    let left = anchor.left;
    left = Math.max(margin, Math.min(left, window.innerWidth - margin - maxPanelW));

    const spaceAbove = anchor.top - gap - margin;
    const minPreferAbove = 120;

    controlsRoot.style.width = `${maxPanelW}px`;
    controlsRoot.style.right = 'auto';

    if (spaceAbove >= minPreferAbove) {
      const maxH = Math.min(maxPanelHCap, spaceAbove);
      controlsRoot.style.bottom = `${window.innerHeight - anchor.top + gap}px`;
      controlsRoot.style.top = 'auto';
      controlsRoot.style.left = `${left}px`;
      controlsRoot.style.maxHeight = `${maxH}px`;
    } else {
      const top = anchor.bottom + gap;
      const maxH = Math.min(maxPanelHCap, window.innerHeight - top - margin);
      controlsRoot.style.top = `${top}px`;
      controlsRoot.style.bottom = 'auto';
      controlsRoot.style.left = `${left}px`;
      controlsRoot.style.maxHeight = `${maxH}px`;
    }
  }

  function clearSaveMenuPosition(): void {
    if (!saveMenu) return;
    saveMenu.style.left = '';
    saveMenu.style.right = '';
    saveMenu.style.top = '';
    saveMenu.style.bottom = '';
    saveMenu.style.width = '';
  }

  /** Align save menu to the same footer top-left anchor as the controls panel (fixed, drop-up when possible). */
  function positionSaveMenu(): void {
    if (!saveMenu || !controlsFooter) return;
    if (saveMenu.classList.contains('hidden')) return;

    const margin = 12;
    const gap = 8;
    const anchor = getControlsFooterAnchor();
    if (!anchor) return;

    saveMenu.style.width = `${anchor.width}px`;

    const w = anchor.width;
    let left = anchor.left;
    left = Math.max(margin, Math.min(left, window.innerWidth - margin - Math.max(w, 120)));

    const spaceAbove = anchor.top - gap - margin;
    const minPreferAbove = 72;

    saveMenu.style.right = 'auto';

    if (spaceAbove >= minPreferAbove) {
      saveMenu.style.bottom = `${window.innerHeight - anchor.top + gap}px`;
      saveMenu.style.top = 'auto';
      saveMenu.style.left = `${left}px`;
    } else {
      const top = anchor.bottom + gap;
      saveMenu.style.top = `${top}px`;
      saveMenu.style.bottom = 'auto';
      saveMenu.style.left = `${left}px`;
    }
  }

  function syncControlsPanel() {
    const has = currentSource !== null;
    if (!has) {
      controlsRoot?.classList.add('hidden');
      controlsMenuBtn?.setAttribute('aria-expanded', 'false');
      clearControlsPanelPosition();
      closeStyleMenu();
      return;
    }
    controlsMenuBtn?.setAttribute('aria-expanded', String(controlsMenuOpen));
    controlsRoot?.classList.toggle('hidden', !controlsMenuOpen);
    if (controlsMenuOpen) {
      positionControlsPanel();
      requestAnimationFrame(() => positionControlsPanel());
    } else {
      clearControlsPanelPosition();
      closeStyleMenu();
    }
  }

  function setControlsMenuOpen(open: boolean) {
    if (open) closeSaveMenu();
    controlsMenuOpen = open;
    syncControlsPanel();
  }

  function setControlsSourcePresent(present: boolean, openMenu = false) {
    controlsScroll?.classList.toggle('hidden', !present);
    controlsFooter?.classList.toggle('hidden', !present);
    if (!present) {
      controlsMenuOpen = false;
    } else if (openMenu) {
      controlsMenuOpen = true;
    }
    syncControlsPanel();
    requestAnimationFrame(() => resizeCanvas());
  }

  /** Legacy hook: mobile uses in-flow controls (no bottom padding reserve). */
  function syncMobileFooterReserve(): void {
    asciiStack?.style.removeProperty('--mobile-footer-reserve');
  }

  let cachedAnalysis: AsciiAnalysis | null = null;
  let cachedAnalysisSource: ImageSource | null = null;
  let cachedAnalysisKey = '';

  function analysisKeyFor(opts: ConversionOptions): string {
    const palette = opts.charMode === 'shaded' ? opts.tonePalette : 'fine-detail';
    return `${opts.outputCols}|${opts.brightness}|${opts.contrast}|${opts.saturation}|${opts.hue}|${opts.invert}|${opts.blur}|${opts.sharpness}|${palette}|${opts.ignoreWhite}`;
  }

  const ANIM_FPS = 18;
  const ANIM_MIN_MS = 1000 / ANIM_FPS;
  let asciiAnimRaf = 0;
  let asciiAnimLastMs = 0;
  let framePlayer: FramePlayer | null = null;
  /** Set when {@link framePlayer} is active; used to treat GIF vs animated WebP differently in export UI. */
  let motionRasterMime: string | null = null;
  let videoEl: HTMLVideoElement | null = null;
  let videoObjectUrl: string | null = null;

  function stopAnimation() {
    if (asciiAnimRaf) {
      cancelAnimationFrame(asciiAnimRaf);
      asciiAnimRaf = 0;
    }
    asciiAnimLastMs = 0;
    if (framePlayer) {
      framePlayer.close();
      framePlayer = null;
      motionRasterMime = null;
    }
    if (videoEl) {
      videoEl.pause();
      videoEl.removeAttribute('src');
      videoEl.load();
      videoEl = null;
    }
    if (videoObjectUrl) {
      URL.revokeObjectURL(videoObjectUrl);
      videoObjectUrl = null;
    }
  }

  function animationTick(now: number) {
    asciiAnimRaf = requestAnimationFrame(animationTick);
    if (framePlayer) {
      if (now - asciiAnimLastMs < ANIM_MIN_MS) return;
      asciiAnimLastMs = now;
      currentSource = {
        drawable: framePlayer.getFrame(),
        width: framePlayer.width,
        height: framePlayer.height,
      };
      rebuildGrid();
      return;
    }
    if (videoEl) {
      if (now - asciiAnimLastMs < ANIM_MIN_MS) return;
      asciiAnimLastMs = now;
      if (videoEl.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA && videoEl.videoWidth > 0) {
        currentSource = {
          drawable: videoEl,
          width: videoEl.videoWidth,
          height: videoEl.videoHeight,
        };
        rebuildGrid();
      }
    }
  }

  function startAnimation() {
    if (!framePlayer && !videoEl) return;
    asciiAnimLastMs = 0;
    asciiAnimRaf = requestAnimationFrame(animationTick);
  }

  function syncSaveTxtVisibility() {
    const isDetail = styleSelect.value.startsWith(SHADED_PREFIX);
    const hideForGif = motionRasterMime === 'image/gif';
    saveTxtBtn.classList.toggle('hidden', !isDetail || hideForGif);
  }

  function updateExportToolbar() {
    const motion = framePlayer !== null || videoEl !== null;
    const hidePngSvgForGif = motionRasterMime === 'image/gif';
    copyBtn.classList.toggle('!hidden', motion);
    saveGifMenuBtn.classList.toggle('hidden', !motion);
    savePngBtn.classList.toggle('hidden', hidePngSvgForGif);
    saveSvgBtn.classList.toggle('hidden', hidePngSvgForGif);
    syncSaveTxtVisibility();
  }

  function frameIndicesForExport(frameCount: number): number[] {
    if (frameCount <= MAX_GIF_FRAMES) {
      return Array.from({ length: frameCount }, (_, i) => i);
    }
    const indices: number[] = [];
    const seen = new Set<number>();
    const last = frameCount - 1;
    for (let j = 0; j < MAX_GIF_FRAMES; j++) {
      const idx = Math.round((j / (MAX_GIF_FRAMES - 1)) * last);
      if (!seen.has(idx)) {
        seen.add(idx);
        indices.push(idx);
      }
    }
    return indices;
  }

  function delaysForFrameIndices(fp: FramePlayer, indices: number[]): number[] {
    const delays: number[] = [];
    for (let j = 0; j < indices.length; j++) {
      const from = indices[j]!;
      const to = j + 1 < indices.length ? indices[j + 1]! : fp.frameCount;
      let sum = 0;
      for (let i = from; i < to; i++) {
        sum += fp.frameDurationMs(i);
      }
      delays.push(Math.max(10, Math.round(sum)));
    }
    return delays;
  }

  function seekVideo(video: HTMLVideoElement, time: number): Promise<void> {
    return new Promise((resolve) => {
      const dur = video.duration;
      const cap = Number.isFinite(dur) && dur > 0 ? dur - 1e-6 : Infinity;
      const t = Math.max(0, Math.min(time, cap));
      const finish = () => {
        video.removeEventListener('seeked', finish);
        resolve();
      };
      if (Math.abs(video.currentTime - t) < 0.02) {
        requestAnimationFrame(finish);
        return;
      }
      video.addEventListener('seeked', finish);
      video.currentTime = t;
    });
  }

  function readOptionsFromDom(): ConversionOptions {
    return {
      pictureForeground: asciiColor.value,
      zoom: parseInt(zoomSlider.value, 10),
      outputCols: parseInt(outputCols.value, 10),
      brightness: parseInt(brightness.value, 10),
      contrast: parseInt(contrast.value, 10),
      saturation: parseInt(saturation.value, 10),
      hue: parseInt(hue.value, 10),
      invert: invertToggle.checked,
      blur: parseFloat(blur.value),
      sharpness: parseInt(sharpness.value, 10),
      ...parseStyleSelect(styleSelect.value),
      ignoreWhite: ignoreWhiteToggle.checked,
    };
  }

  const rangeBarInputs: HTMLInputElement[] = [
    zoomSlider,
    outputCols,
    blur,
    sharpness,
    brightness,
    contrast,
    saturation,
    hue,
  ];

  function syncRangeBarStyle(el: HTMLInputElement) {
    const min = parseFloat(el.min);
    const max = parseFloat(el.max);
    const val = parseFloat(el.value);
    const thumbPct = max === min ? 0 : ((val - min) / (max - min)) * 100;
    el.style.setProperty('--range-thumb-pct', `${thumbPct}%`);
  }

  function syncStyleSelectLabel() {
    if (!styleSelectCurrent) return;
    const opt = styleSelect.selectedOptions[0];
    const raw = opt?.text?.trim() ?? styleSelect.value;
    styleSelectCurrent.textContent = raw.toUpperCase();
  }

  function syncLabels() {
    zoomValue.textContent = zoomSlider.value;
    outputColsVal.textContent = outputCols.value;
    brightnessVal.textContent = brightness.value;
    contrastVal.textContent = contrast.value;
    saturationVal.textContent = saturation.value;
    hueVal.textContent = hue.value;
    blurVal.textContent = blur.value;
    sharpnessVal.textContent = sharpness.value;
    rangeBarInputs.forEach(syncRangeBarStyle);
    syncStyleSelectLabel();
  }

  function positionStyleMenu() {
    if (!styleSelectTrigger || !styleSelectMenu) return;
    const rect = styleSelectTrigger.getBoundingClientRect();
    const gap = 4;
    styleSelectMenu.style.left = `${rect.left}px`;
    styleSelectMenu.style.top = `${rect.bottom + gap}px`;
    styleSelectMenu.style.width = `${Math.max(rect.width, 168)}px`;
  }

  function setStyleMenuOpen(open: boolean) {
    if (!styleSelectTrigger || !styleSelectMenu) return;
    styleSelectTrigger.setAttribute('aria-expanded', String(open));
    styleSelectMenu.classList.toggle('hidden', !open);
    if (open) {
      positionStyleMenu();
      requestAnimationFrame(() => positionStyleMenu());
    }
  }

  function closeStyleMenu() {
    setStyleMenuOpen(false);
  }

  function resizeCanvas() {
    syncMobileFooterReserve();
    if (currentSource) rebuildGrid();
    if (controlsMenuOpen) {
      positionControlsPanel();
      requestAnimationFrame(() => positionControlsPanel());
    }
    if (saveMenuBtn?.getAttribute('aria-expanded') === 'true') {
      positionSaveMenu();
      requestAnimationFrame(() => positionSaveMenu());
    }
  }

  function rebuildGrid() {
    if (!currentSource) return;
    conv = readOptionsFromDom();
    renderer.setDisplayZoom(conv.zoom);

    const key = analysisKeyFor(conv);
    const sourceChanged = currentSource !== cachedAnalysisSource;
    if (!cachedAnalysis || sourceChanged || key !== cachedAnalysisKey) {
      cachedAnalysis = analyzeImage(currentSource, conv);
      cachedAnalysisSource = currentSource;
      cachedAnalysisKey = key;
    }

    const { lines, grid, singleTintColor, htmlLines } = layoutAnalysis(
      cachedAnalysis,
      asciiPre.clientWidth,
      asciiPre.clientHeight,
      conv,
    );
    renderer.load({ lines, grid, singleTintColor, htmlLines });
  }

  const resizeObserver = new ResizeObserver(() => resizeCanvas());
  resizeObserver.observe(container);
  resizeCanvas();

  const footerResizeObserver = new ResizeObserver(() => {
    resizeCanvas();
  });
  if (controlsDock) footerResizeObserver.observe(controlsDock);
  if (controlsFooter) footerResizeObserver.observe(controlsFooter);

  const WEBP_HEAD_BYTES = 256 * 1024;

  async function loadVideo(file: File) {
    videoObjectUrl = URL.createObjectURL(file);
    const video = document.createElement('video');
    video.muted = true;
    video.playsInline = true;
    video.loop = true;
    video.setAttribute('playsinline', '');
    video.src = videoObjectUrl;

    try {
      await new Promise<void>((resolve, reject) => {
        video.addEventListener('loadedmetadata', () => resolve(), { once: true });
        video.addEventListener('error', () => reject(new Error('video load failed')), { once: true });
      });
    } catch {
      URL.revokeObjectURL(videoObjectUrl);
      videoObjectUrl = null;
      return;
    }

    if (video.videoWidth === 0 || video.videoHeight === 0) {
      URL.revokeObjectURL(videoObjectUrl);
      videoObjectUrl = null;
      return;
    }

    videoEl = video;
    try {
      await video.play();
    } catch {
      /* autoplay may be blocked; export still works */
    }

    currentSource = {
      drawable: video,
      width: video.videoWidth,
      height: video.videoHeight,
    };
    rebuildGrid();
    uploadZone.style.display = 'none';
    setControlsSourcePresent(true, true);
    updateExportToolbar();
    startAnimation();
  }

  async function loadImage(file: File) {
    stopAnimation();

    await ensureFontLoaded();
    clearMetricsCache();

    if (file.type.startsWith('video/')) {
      await loadVideo(file);
      return;
    }

    const buf = await file.arrayBuffer();
    const mime = file.type;

    let isAnimated = mime === 'image/gif';
    if (mime === 'image/webp') {
      try {
        isAnimated = isAnimatedWebP(buf.slice(0, Math.min(buf.byteLength, WEBP_HEAD_BYTES)));
      } catch {
        isAnimated = false;
      }
    }

    if (isAnimated) {
      const player = await FramePlayer.create(buf, mime);
      if (player) {
        framePlayer = player;
        motionRasterMime = mime;
        currentSource = {
          drawable: player.getFrame(),
          width: player.width,
          height: player.height,
        };
        rebuildGrid();
        uploadZone.style.display = 'none';
        setControlsSourcePresent(true, true);
        updateExportToolbar();
        startAnimation();
        return;
      }
    }

    const blob = new Blob([buf], { type: mime });
    const url = URL.createObjectURL(blob);
    const img = new Image();
    img.onload = () => {
      currentSource = { drawable: img, width: img.naturalWidth, height: img.naturalHeight };
      rebuildGrid();
      uploadZone.style.display = 'none';
      setControlsSourcePresent(true, true);
      updateExportToolbar();
      URL.revokeObjectURL(url);
    };
    img.src = url;
  }

  const uploadTarget = uploadZonePanel ?? uploadZone;
  uploadTarget.addEventListener('click', () => fileInput.click());
  uploadTarget.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') fileInput.click();
  });

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) loadImage(file);
  });

  uploadTarget.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadTarget.classList.add('opacity-80');
  });

  uploadTarget.addEventListener('dragleave', () => {
    uploadTarget.classList.remove('opacity-80');
  });

  uploadTarget.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadTarget.classList.remove('opacity-80');
    const file = e.dataTransfer?.files[0];
    if (file && (file.type.startsWith('image/') || file.type.startsWith('video/'))) loadImage(file);
  });

  const filterInputs: (HTMLInputElement | HTMLSelectElement)[] = [
    asciiColor,
    zoomSlider,
    outputCols,
    brightness,
    contrast,
    saturation,
    hue,
    invertToggle,
    blur,
    sharpness,
    styleSelect,
    ignoreWhiteToggle,
  ];

  filterInputs.forEach((el) => {
    el.addEventListener('input', () => {
      syncLabels();
      if (el === styleSelect) syncSaveTxtVisibility();
      if (currentSource) rebuildGrid();
    });
    el.addEventListener('change', () => {
      syncLabels();
      if (el === styleSelect) syncSaveTxtVisibility();
      if (currentSource) rebuildGrid();
    });
  });

  asciiColorPresetButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const hex = btn.dataset.asciiColor;
      if (!hex) return;
      asciiColor.value = hex;
      asciiColorPresetButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === btn));
      });
      asciiColor.dispatchEvent(new Event('input', { bubbles: true }));
    });
  });

  syncAsciiColorSwatches();

  copyBtn.addEventListener('click', async () => {
    const text = renderer.getText();
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      copyBtn.innerHTML = copySuccessSvg;
      copyBtn.setAttribute('aria-label', 'Copied');
      setTimeout(() => {
        copyBtn.innerHTML = copyBtnDefaultHtml;
        copyBtn.setAttribute('aria-label', 'Copy');
      }, 2000);
    } catch {
      /* clipboard unavailable */
    }
  });

  asciiPre.addEventListener('copy', (e) => {
    const text = renderer.getText();
    if (!text) return;
    e.preventDefault();
    e.clipboardData?.setData('text/plain', text);
  });

  function setSaveMenuOpen(open: boolean) {
    if (!saveMenuBtn || !saveMenu) return;
    if (open) setControlsMenuOpen(false);
    saveMenuBtn.setAttribute('aria-expanded', String(open));
    saveMenu.classList.toggle('hidden', !open);
    if (open) {
      positionSaveMenu();
      requestAnimationFrame(() => positionSaveMenu());
    } else {
      clearSaveMenuPosition();
    }
  }

  function closeSaveMenu() {
    setSaveMenuOpen(false);
  }

  if (saveMenuBtn && saveMenu && saveDropdown) {
    saveMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = saveMenuBtn.getAttribute('aria-expanded') === 'true';
      setSaveMenuOpen(!open);
    });

    document.addEventListener('mousedown', (e) => {
      if (!saveDropdown.contains(e.target as Node)) closeSaveMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && saveMenuBtn.getAttribute('aria-expanded') === 'true') {
        closeSaveMenu();
        saveMenuBtn.focus();
      }
    });
  }

  if (controlsMenuBtn) {
    controlsMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!currentSource) return;
      setControlsMenuOpen(!controlsMenuOpen);
    });
  }

  window.addEventListener(
    'scroll',
    () => {
      if (controlsMenuOpen) positionControlsPanel();
      if (saveMenuBtn?.getAttribute('aria-expanded') === 'true') positionSaveMenu();
    },
    true
  );

  document.addEventListener('mousedown', (e) => {
    if (!currentSource || !controlsMenuOpen) return;
    const t = e.target as Node;
    if (controlsRoot?.contains(t)) return;
    if (controlsFooter?.contains(t)) return;
    setControlsMenuOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !currentSource || !controlsMenuOpen) return;
    setControlsMenuOpen(false);
    controlsMenuBtn?.focus();
  });

  if (styleSelectTrigger && styleSelectMenu && styleSelectDropdown) {
    styleSelectTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = styleSelectTrigger.getAttribute('aria-expanded') === 'true';
      setStyleMenuOpen(!open);
    });

    styleSelectMenu.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('[data-value]');
      if (!t) return;
      const v = t.getAttribute('data-value');
      if (!v) return;
      styleSelect.value = v;
      syncStyleSelectLabel();
      closeStyleMenu();
      styleSelect.dispatchEvent(new Event('input', { bubbles: true }));
      styleSelect.dispatchEvent(new Event('change', { bubbles: true }));
    });

    document.addEventListener('mousedown', (e) => {
      if (!styleSelectDropdown.contains(e.target as Node)) closeStyleMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && styleSelectTrigger.getAttribute('aria-expanded') === 'true') {
        closeStyleMenu();
        styleSelectTrigger.focus();
      }
    });

  }

  window.addEventListener('resize', () => {
    if (styleSelectTrigger?.getAttribute('aria-expanded') === 'true') positionStyleMenu();
    if (controlsMenuOpen) {
      positionControlsPanel();
      requestAnimationFrame(() => positionControlsPanel());
    }
    if (saveMenuBtn?.getAttribute('aria-expanded') === 'true') {
      positionSaveMenu();
      requestAnimationFrame(() => positionSaveMenu());
    }
  });

  if (controlsScroll) {
    controlsScroll.addEventListener('scroll', () => {
      flashControlsScrollbar();
      if (styleSelectTrigger && styleSelectTrigger.getAttribute('aria-expanded') === 'true') {
        closeStyleMenu();
      }
    });
  }

  saveTxtBtn.addEventListener('click', () => {
    const text = renderer.getText();
    if (!text.trim()) return;
    downloadAsciiText(text);
    closeSaveMenu();
  });

  savePngBtn.addEventListener('click', () => {
    const text = renderer.getText();
    if (!text.trim()) return;
    conv = readOptionsFromDom();
    downloadAsciiPng(text, {
      pictureForeground: conv.pictureForeground,
      ...(conv.charMode !== 'shaded' && cachedAnalysis
        ? { cellBrightness: cachedAnalysis.gray, cols: cachedAnalysis.cols }
        : {}),
    });
    closeSaveMenu();
  });

  saveSvgBtn.addEventListener('click', async () => {
    const text = renderer.getText();
    if (!text.trim()) return;
    conv = readOptionsFromDom();
    closeSaveMenu();
    await downloadAsciiSvg(text, {
      pictureForeground: conv.pictureForeground,
      ...(conv.charMode !== 'shaded' && cachedAnalysis
        ? { cellBrightness: cachedAnalysis.gray, cols: cachedAnalysis.cols }
        : {}),
    });
  });

  saveHtmlBtn.addEventListener('click', async () => {
    const text = renderer.getText();
    if (!text.trim()) return;
    closeSaveMenu();
    conv = readOptionsFromDom();

    const isMotion = framePlayer !== null || videoEl !== null;

    if (!isMotion) {
      downloadAsciiHtml(text, {
        pictureForeground: conv.pictureForeground,
        backgroundColor: getPageBackgroundColor(),
        htmlLines: renderer.getHtmlLines(),
      });
      return;
    }

    const prevRaf = asciiAnimRaf;
    if (prevRaf) {
      cancelAnimationFrame(prevRaf);
      asciiAnimRaf = 0;
    }
    const wasVideoPlaying = Boolean(videoEl && !videoEl.paused);
    if (videoEl) videoEl.pause();
    saveHtmlBtn.disabled = true;

    try {
      const htmlFrames: AsciiHtmlFrame[] = [];

      if (framePlayer) {
        const fp = framePlayer;
        const indices = frameIndicesForExport(fp.frameCount);
        const delays = delaysForFrameIndices(fp, indices);

        for (let i = 0; i < indices.length; i++) {
          const idx = indices[i]!;
          currentSource = { drawable: fp.getFrameAtIndex(idx), width: fp.width, height: fp.height };
          cachedAnalysis = null;
          cachedAnalysisKey = '';
          cachedAnalysisSource = null;
          rebuildGrid();
          const frameHtmlLines = renderer.getHtmlLines();
          const frameText = renderer.getText();
          htmlFrames.push({
            html: frameHtmlLines ? frameHtmlLines.join('\n') : escapeHtmlForExport(frameText),
            delayMs: delays[i]!,
          });
        }
      } else if (videoEl) {
        const video = videoEl;
        const duration = video.duration;
        if (!Number.isFinite(duration) || duration <= 0) return;

        const targetFrames = Math.min(MAX_GIF_FRAMES, Math.max(1, Math.floor(duration * VIDEO_EXPORT_FPS)));
        const step = duration / targetFrames;
        const delayMs = Math.max(20, Math.round(step * 1000));

        for (let k = 0; k < targetFrames; k++) {
          const t = k === targetFrames - 1 ? Math.max(0, duration - 0.04) : k * step;
          await seekVideo(video, t);
          currentSource = { drawable: video, width: video.videoWidth, height: video.videoHeight };
          cachedAnalysis = null;
          cachedAnalysisKey = '';
          cachedAnalysisSource = null;
          rebuildGrid();
          const frameHtmlLines = renderer.getHtmlLines();
          const frameText = renderer.getText();
          htmlFrames.push({
            html: frameHtmlLines ? frameHtmlLines.join('\n') : escapeHtmlForExport(frameText),
            delayMs,
          });
        }
      }

      if (htmlFrames.length === 0) return;

      downloadAsciiHtml(renderer.getText(), {
        pictureForeground: conv.pictureForeground,
        backgroundColor: getPageBackgroundColor(),
        htmlLines: renderer.getHtmlLines(),
        frames: htmlFrames,
      });
    } finally {
      saveHtmlBtn.disabled = false;
      if (videoEl && wasVideoPlaying) void videoEl.play();
      startAnimation();
    }
  });

  saveGifMenuBtn.addEventListener('click', async () => {
    if (!framePlayer && !videoEl) return;
    closeSaveMenu();

    const prevRaf = asciiAnimRaf;
    if (prevRaf) {
      cancelAnimationFrame(prevRaf);
      asciiAnimRaf = 0;
    }
    const wasVideoPlaying = Boolean(videoEl && !videoEl.paused);
    if (videoEl) videoEl.pause();

    saveGifMenuBtn.disabled = true;

    try {
      conv = readOptionsFromDom();
      const scale = 4;
      const pictureForeground = conv.pictureForeground;
      const needsBrightness = conv.charMode !== 'shaded';
      const frames: { canvas: HTMLCanvasElement; delayMs: number }[] = [];

      if (framePlayer) {
        const fp = framePlayer;
        const indices = frameIndicesForExport(fp.frameCount);
        const delays = delaysForFrameIndices(fp, indices);

        for (let i = 0; i < indices.length; i++) {
          const idx = indices[i]!;
          currentSource = {
            drawable: fp.getFrameAtIndex(idx),
            width: fp.width,
            height: fp.height,
          };
          cachedAnalysis = null;
          cachedAnalysisKey = '';
          cachedAnalysisSource = null;
          rebuildGrid();
          const text = renderer.getText();
          const a1 = cachedAnalysis as AsciiAnalysis | null;
          const canvas = createAsciiExportCanvas(text, {
            pictureForeground,
            scale,
            ...(needsBrightness && a1
              ? { cellBrightness: a1.gray, cols: a1.cols }
              : {}),
          });
          if (!canvas) continue;
          frames.push({ canvas, delayMs: delays[i]! });
        }
      } else if (videoEl) {
        const video = videoEl;
        const duration = video.duration;
        if (!Number.isFinite(duration) || duration <= 0) return;

        const targetFrames = Math.min(
          MAX_GIF_FRAMES,
          Math.max(1, Math.floor(duration * VIDEO_EXPORT_FPS)),
        );
        const step = duration / targetFrames;
        const delayMs = Math.max(20, Math.round(step * 1000));

        for (let k = 0; k < targetFrames; k++) {
          const t = k === targetFrames - 1 ? Math.max(0, duration - 0.04) : k * step;
          await seekVideo(video, t);
          currentSource = {
            drawable: video,
            width: video.videoWidth,
            height: video.videoHeight,
          };
          cachedAnalysis = null;
          cachedAnalysisKey = '';
          cachedAnalysisSource = null;
          rebuildGrid();
          const text = renderer.getText();
          const a2 = cachedAnalysis as AsciiAnalysis | null;
          const canvas = createAsciiExportCanvas(text, {
            pictureForeground,
            scale,
            ...(needsBrightness && a2
              ? { cellBrightness: a2.gray, cols: a2.cols }
              : {}),
          });
          if (!canvas) continue;
          frames.push({ canvas, delayMs });
        }
      }

      if (frames.length === 0) return;
      const bytes = encodeAsciiCanvasesToGif(frames, pictureForeground, needsBrightness);
      downloadGifBytes(bytes);
    } finally {
      saveGifMenuBtn.disabled = false;
      if (videoEl && wasVideoPlaying) {
        void videoEl.play();
      }
      startAnimation();
    }
  });

  newImageBtn.addEventListener('click', () => {
    stopAnimation();
    currentSource = null;
    cachedAnalysis = null;
    cachedAnalysisSource = null;
    cachedAnalysisKey = '';
    uploadZone.style.display = '';
    setControlsSourcePresent(false);
    fileInput.value = '';
    renderer.clear();
  });

  syncLabels();
  syncSaveTxtVisibility();
  syncControlsPanel();

  ensureFontLoaded().then(() => {
    clearMetricsCache();
    if (currentSource) {
      cachedAnalysis = null;
      cachedAnalysisKey = '';
      rebuildGrid();
    }
  });
</script>
