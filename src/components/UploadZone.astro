---
---

<div
  id="upload-zone"
  class="absolute inset-0 flex flex-col items-center justify-center z-10 cursor-default transition-all duration-300"
  role="button"
  tabindex="0"
  aria-label="Upload image"
>
  <!-- Dashed border overlay -->
  <div
    class="upload-zone-panel group border border-white/5 rounded-none p-10 sm:p-16 flex h-full w-full flex-col items-center justify-center gap-4 bg-[#141314] transition-colors duration-300 hover:bg-[color-mix(in_srgb,white_1%,#141314)]"
  >
    <svg
      class="h-[30px] w-[30px] shrink-0 select-none text-white/50 transition-colors duration-300 group-hover:text-white/90"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M8 20H14V18H16V20H20V22H4V20H6V18H8V20ZM4 20H2V4H4V20ZM22 20H20V16H18V14H20V4H22V20ZM10 18H8V16H10V18ZM14 18H12V16H14V18ZM12 16H10V14H12V16ZM16 16H14V14H16V16ZM18 14H16V12H18V14ZM10 12H8V10H10V12ZM8 10H6V8H8V10ZM12 10H10V8H12V10ZM10 8H8V6H10V8ZM20 4H4V2H20V4Z"
        fill="currentColor"
      />
      <g class="upload-zone-pixels">
        <!-- Sequence: red → blue → green → yellow (see CSS keyframes) -->
        <rect
          class="upload-zone-pixel upload-zone-pixel--red"
          x="8"
          y="6"
          width="2"
          height="2"
          fill="#FF0004"
        />
        <rect
          class="upload-zone-pixel upload-zone-pixel--blue"
          x="10"
          y="8"
          width="2"
          height="2"
          fill="#1100FF"
        />
        <rect
          class="upload-zone-pixel upload-zone-pixel--green"
          x="8"
          y="10"
          width="2"
          height="2"
          fill="#22E439"
        />
        <rect
          class="upload-zone-pixel upload-zone-pixel--yellow"
          x="6"
          y="8"
          width="2"
          height="2"
          fill="#FFC300"
        />
      </g>
    </svg>
  </div>

  <input
    type="file"
    id="file-input"
    accept="image/*"
    class="hidden"
    aria-label="Upload image file"
  />
</div>

<style>
  .upload-zone-pixels {
    opacity: 0;
    transition: opacity 300ms;
  }

  .upload-zone-panel:hover .upload-zone-pixels {
    opacity: 1;
  }

  /* Dim: red & blue 50%; green & yellow 60%. Eased ramps per quarter-cycle. */
  @keyframes upload-pixel-red {
    0%,
    2% {
      opacity: 0.5;
    }
    8% {
      opacity: 1;
    }
    14%,
    17% {
      opacity: 1;
    }
    24% {
      opacity: 0.5;
    }
    25%,
    100% {
      opacity: 0.5;
    }
  }

  @keyframes upload-pixel-blue {
    0%,
    25% {
      opacity: 0.5;
    }
    28% {
      opacity: 0.5;
    }
    33% {
      opacity: 1;
    }
    39%,
    42% {
      opacity: 1;
    }
    49% {
      opacity: 0.5;
    }
    50%,
    100% {
      opacity: 0.5;
    }
  }

  @keyframes upload-pixel-green {
    0%,
    50% {
      opacity: 0.6;
    }
    53% {
      opacity: 0.6;
    }
    58% {
      opacity: 1;
    }
    64%,
    67% {
      opacity: 1;
    }
    74% {
      opacity: 0.6;
    }
    75%,
    100% {
      opacity: 0.6;
    }
  }

  @keyframes upload-pixel-yellow {
    0%,
    75% {
      opacity: 0.6;
    }
    78% {
      opacity: 0.6;
    }
    83% {
      opacity: 1;
    }
    89%,
    92% {
      opacity: 1;
    }
    99% {
      opacity: 0.6;
    }
    100% {
      opacity: 0.6;
    }
  }

  .upload-zone-panel:hover .upload-zone-pixel--red {
    animation: upload-pixel-red var(--upload-pixel-cycle, 2.5s) cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .upload-zone-panel:hover .upload-zone-pixel--blue {
    animation: upload-pixel-blue var(--upload-pixel-cycle, 2.5s) cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .upload-zone-panel:hover .upload-zone-pixel--green {
    animation: upload-pixel-green var(--upload-pixel-cycle, 2.5s) cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .upload-zone-panel:hover .upload-zone-pixel--yellow {
    animation: upload-pixel-yellow var(--upload-pixel-cycle, 2.5s) cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .upload-zone-panel:hover .upload-zone-pixel--red,
    .upload-zone-panel:hover .upload-zone-pixel--blue {
      animation: none;
      opacity: 0.5;
    }

    .upload-zone-panel:hover .upload-zone-pixel--green {
      animation: none;
      opacity: 0.6;
    }

    .upload-zone-panel:hover .upload-zone-pixel--yellow {
      animation: none;
      opacity: 0.6;
    }
  }
</style>
