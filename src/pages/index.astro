---
import Layout from '../layouts/Layout.astro';
import AsciiCanvas from '../components/AsciiCanvas.astro';
import UploadZone from '../components/UploadZone.astro';
import Controls from '../components/Controls.astro';
---

<Layout title="ASCII">
  <div
    class="flex min-h-0 w-[950px] max-w-[min(950px,100vw)] flex-col items-center justify-center gap-[18px] px-5 max-md:h-auto max-md:max-h-none md:h-[min(600px,calc(100dvh_-_var(--layout-pad-y)))] md:min-h-0 lg:px-0 md:flex-row"
  >
    <section
      class="flex min-h-0 min-w-0 flex-col self-stretch max-md:aspect-square max-md:w-full max-md:flex-none md:min-h-0 md:flex-1"
    >
      <AsciiCanvas>
        <UploadZone />
      </AsciiCanvas>
    </section>
    <Controls class="self-stretch" />
  </div>
</Layout>
