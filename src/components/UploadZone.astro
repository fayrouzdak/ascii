---
---

<div
  id="upload-zone"
  class="pointer-events-none absolute inset-0 z-40 flex flex-col items-center justify-center transition-all duration-300 max-md:px-4"
>
  <!-- Hit target and visuals: same box (no full-screen invisible capture) -->
  <div
    id="upload-zone-panel"
    class="upload-zone-panel group pointer-events-auto relative flex h-full w-full cursor-default flex-col items-center justify-center gap-4 rounded-none border border-white/5 bg-[#141314] p-10 transition-colors duration-300 hover:bg-[color-mix(in_srgb,white_1%,#141314)] sm:p-16 max-md:mx-auto max-md:h-auto max-md:max-h-full max-md:max-w-full max-md:shrink-0 max-md:aspect-square max-md:w-full"
    role="button"
    tabindex="0"
    aria-label="Upload image or video"
  >
    <div
      id="upload-zone-icon-drag"
      class="absolute left-1/2 top-1/2 z-[1] h-[30px] w-[30px] -ml-[15px] -mt-[15px] cursor-grab touch-none select-none active:cursor-grabbing"
      aria-hidden="true"
    >
      <svg
        class="pointer-events-none h-[30px] w-[30px] text-white/50 transition-colors duration-300 group-hover:text-white/90"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M8 20H14V18H16V20H20V22H4V20H6V18H8V20ZM4 20H2V4H4V20ZM22 20H20V16H18V14H20V4H22V20ZM10 18H8V16H10V18ZM14 18H12V16H14V18ZM12 16H10V14H12V16ZM16 16H14V14H16V16ZM18 14H16V12H18V14ZM10 12H8V10H10V12ZM8 10H6V8H8V10ZM12 10H10V8H12V10ZM10 8H8V6H10V8ZM20 4H4V2H20V4Z"
          fill="currentColor"
        />
        <g class="upload-zone-pixels">
          <!-- Sequence: red → blue → green → yellow (see CSS keyframes) -->
          <rect
            class="upload-zone-pixel upload-zone-pixel--red"
            x="8"
            y="6"
            width="2"
            height="2"
            fill="#FF0004"
          />
          <rect
            class="upload-zone-pixel upload-zone-pixel--blue"
            x="10"
            y="8"
            width="2"
            height="2"
            fill="#1100FF"
          />
          <rect
            class="upload-zone-pixel upload-zone-pixel--green"
            x="8"
            y="10"
            width="2"
            height="2"
            fill="#24D1B2"
          />
          <rect
            class="upload-zone-pixel upload-zone-pixel--yellow"
            x="6"
            y="8"
            width="2"
            height="2"
            fill="#E99514"
          />
        </g>
      </svg>
    </div>
  </div>

  <input
    type="file"
    id="file-input"
    accept="image/*,video/*"
    class="hidden"
    aria-label="Upload image or video file"
  />
</div>

<style>
  .upload-zone-pixels {
    opacity: 0;
    transition: opacity 300ms;
  }

  .upload-zone-panel:hover .upload-zone-pixels {
    opacity: 1;
  }

  /* Dim: red/blue 50%; green/yellow 40% for a stronger pulse on the warmer pair. */
  @keyframes upload-pixel-red {
    0%,
    2% {
      opacity: 0.5;
    }
    8% {
      opacity: 1;
    }
    14%,
    17% {
      opacity: 1;
    }
    24% {
      opacity: 0.5;
    }
    25%,
    100% {
      opacity: 0.5;
    }
  }

  @keyframes upload-pixel-blue {
    0%,
    25% {
      opacity: 0.5;
    }
    28% {
      opacity: 0.5;
    }
    33% {
      opacity: 1;
    }
    39%,
    42% {
      opacity: 1;
    }
    49% {
      opacity: 0.5;
    }
    50%,
    100% {
      opacity: 0.5;
    }
  }

  @keyframes upload-pixel-green {
    0%,
    50% {
      opacity: 0.4;
    }
    53% {
      opacity: 0.4;
    }
    58% {
      opacity: 1;
    }
    64%,
    67% {
      opacity: 1;
    }
    74% {
      opacity: 0.4;
    }
    75%,
    100% {
      opacity: 0.4;
    }
  }

  @keyframes upload-pixel-yellow {
    0%,
    75% {
      opacity: 0.4;
    }
    78% {
      opacity: 0.4;
    }
    83% {
      opacity: 1;
    }
    89%,
    92% {
      opacity: 1;
    }
    99% {
      opacity: 0.4;
    }
    100% {
      opacity: 0.4;
    }
  }

  .upload-zone-panel:hover .upload-zone-pixel--red {
    animation: upload-pixel-red var(--upload-pixel-cycle, 2.5s) cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .upload-zone-panel:hover .upload-zone-pixel--blue {
    animation: upload-pixel-blue var(--upload-pixel-cycle, 2.5s) cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .upload-zone-panel:hover .upload-zone-pixel--green {
    animation: upload-pixel-green var(--upload-pixel-cycle, 2.5s) cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .upload-zone-panel:hover .upload-zone-pixel--yellow {
    animation: upload-pixel-yellow var(--upload-pixel-cycle, 2.5s) cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .upload-zone-panel:hover .upload-zone-pixel--red,
    .upload-zone-panel:hover .upload-zone-pixel--blue {
      animation: none;
      opacity: 0.5;
    }

    .upload-zone-panel:hover .upload-zone-pixel--green {
      animation: none;
      opacity: 0.4;
    }

    .upload-zone-panel:hover .upload-zone-pixel--yellow {
      animation: none;
      opacity: 0.4;
    }
  }
</style>

<script>
  const ICON = 30;
  const DRAG_THRESHOLD_PX = 4;

  function clampOffset(px: number, py: number, panel: HTMLElement): { x: number; y: number } {
    const w = panel.clientWidth;
    const h = panel.clientHeight;
    const maxX = Math.max(0, w / 2 - ICON / 2);
    const maxY = Math.max(0, h / 2 - ICON / 2);
    return {
      x: Math.min(maxX, Math.max(-maxX, px)),
      y: Math.min(maxY, Math.max(-maxY, py)),
    };
  }

  function initUploadZoneIconDrag() {
    const handleEl = document.getElementById('upload-zone-icon-drag');
    const panelEl = document.getElementById('upload-zone-panel');
    if (!(handleEl instanceof HTMLElement) || !(panelEl instanceof HTMLElement)) return;
    const drag = handleEl;
    const zone = panelEl;

    let x = 0;
    let y = 0;
    let dragging = false;
    let moved = false;
    let startClientX = 0;
    let startClientY = 0;
    let startX = 0;
    let startY = 0;

    function applyTransform() {
      drag.style.transform = `translate(${x}px, ${y}px)`;
    }

    drag.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      dragging = true;
      moved = false;
      startClientX = e.clientX;
      startClientY = e.clientY;
      startX = x;
      startY = y;
      drag.setPointerCapture(e.pointerId);
    });

    drag.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startClientX;
      const dy = e.clientY - startClientY;
      if (Math.hypot(dx, dy) > DRAG_THRESHOLD_PX) moved = true;
      const next = clampOffset(startX + dx, startY + dy, zone);
      x = next.x;
      y = next.y;
      applyTransform();
    });

    function endDrag(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      try {
        drag.releasePointerCapture(e.pointerId);
      } catch {
        /* not capturing */
      }
    }

    drag.addEventListener('pointerup', endDrag);
    drag.addEventListener('pointercancel', endDrag);

    drag.addEventListener('click', (e) => {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
      }
    });

    window.addEventListener('resize', () => {
      const next = clampOffset(x, y, zone);
      x = next.x;
      y = next.y;
      applyTransform();
    });

    applyTransform();
  }

  initUploadZoneIconDrag();
</script>
