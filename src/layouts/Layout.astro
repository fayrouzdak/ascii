---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'ASCII' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="ASCII transforms images into dynamic grids of text characters, blending retro aesthetics with modern digital art." />
    <title>{title}</title>
  </head>
  <body
    class="box-border flex min-h-screen items-center justify-center overflow-x-hidden overflow-y-auto bg-[#141314] pb-[max(40px,env(safe-area-inset-bottom,0px))] pt-[max(40px,env(safe-area-inset-top,0px))] text-[15px] uppercase text-white"
  >
    <slot />
  </body>
</html>
