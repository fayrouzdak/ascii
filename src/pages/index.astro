---
import Layout from '../layouts/Layout.astro';
import AsciiCanvas from '../components/AsciiCanvas.astro';
import UploadZone from '../components/UploadZone.astro';
import Controls from '../components/Controls.astro';
---

<Layout title="ASCII Motion — Code Meets Movement">
  <div class="flex h-[520px] max-h-[min(520px,100vh)] w-[839px] max-w-[min(839px,100vw)] min-h-0 flex-col items-center justify-center gap-3 md:flex-row">
    <section class="flex min-h-0 min-w-0 flex-1 flex-col self-stretch md:min-h-0">
      <AsciiCanvas>
        <UploadZone />
      </AsciiCanvas>
    </section>
    <Controls class="self-stretch" />
  </div>
</Layout>
